# Copy to .env (gitignored). Never commit real keys.
ANTHROPIC_API_KEY=

# Front-end origins the browser may call the API from (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173

# Database paths. Leave unset to use the defaults (src/data/morphology.db, ./llm.db).
# MORPHOLOGY_DB=
# LLM_DB=

# Daily limits (ADR-005, Decision 7). Leave unset to use the defaults shown.
# LIMITS_DB=limits.db
# DAILY_REQUEST_LIMIT=20    # AI requests per browser per UTC day
# IP_DAILY_LIMIT=20         # AI requests per IP address per UTC day
# DAILY_SPEND_CAP_USD=0.50  # the server stops calling the model after this much a day
# IP_HASH_SALT=             # any long random string; set it in production
